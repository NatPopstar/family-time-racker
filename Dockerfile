# Образ для разработки.
#
# Берём готовый образ с уже установленным Node.js 24.
# "slim" — урезанная версия Debian: меньше весит, но, в отличие от alpine,
# использует обычную библиотеку glibc, с которой у сборщиков Vite/esbuild
# не бывает неожиданных проблем. Для новичка это на один источник багов меньше.
FROM node:24-slim

# Все команды дальше выполняются в папке /app внутри контейнера.
WORKDIR /app

# Порт, на котором Vite отдаёт страницу. EXPOSE — это документация:
# реальную связь с компьютером настраивает docker-compose.yml.
EXPOSE 5173

# Команда по умолчанию.
# Сначала доустанавливаем зависимости (быстро, если они уже в томе),
# затем поднимаем сервер разработки.
CMD ["sh", "-c", "npm install && npm run dev"]

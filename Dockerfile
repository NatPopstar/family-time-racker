# Образ для разработки.
#
# Берём готовый образ с уже установленным Node.js 24.
# "slim" — урезанная версия Debian: меньше весит, но, в отличие от alpine,
# использует обычную библиотеку glibc, с которой у сборщиков Vite/esbuild
# не бывает неожиданных проблем. Для новичка это на один источник багов меньше.
FROM node:24-slim

# Все команды дальше выполняются в папке /app внутри контейнера.
WORKDIR /app

# Порт, на котором Vite отдаёт страницу. EXPOSE — это документация:
# реальную связь с компьютером настраивает docker-compose.yml.
EXPOSE 5173

# Команда по умолчанию.
#
# Зависимости ставим ТОЛЬКО если их ещё нет. Раньше здесь стояло
# безусловное `npm install && npm run dev`, и это оказалось ошибкой:
# при каждом запуске приложение зависело от реестра npm и от записи
# в примонтированную папку на медленном USB-диске. Однажды npm там
# намертво завис на блокировке файла, и приложение просто не открылось,
# хотя все 186 пакетов лежали в томе на месте.
#
# Проверяем наличие vite, а не самой папки node_modules: пустая папка
# может остаться от прерванной установки и обманула бы проверку.
CMD ["sh", "-c", "[ -d node_modules/vite ] || npm install; npm run dev"]
